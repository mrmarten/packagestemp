+				w.i16(p.yaw) && w.i16(p.pitch) && w.i16(p.sectorIndex) && w.u8(p.weapon) && w.u8(p.flags) &&
+				w.i16(p.health) && w.i16(p.shields) && w.u16(p.triggerGoals) && w.u16(p.itemGoals);
+		}, out);
+	}
+	bool decodePlayerState(const PacketView& packet, PlayerState& p)
+	{
