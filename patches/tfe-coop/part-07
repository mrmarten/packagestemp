+	Protocol::Header Session::makeHeader(Protocol::PacketType type, std::uint32_t sessionIdOverride)
+	{
+		Protocol::Header header;
+		header.type = type;
+		header.sessionId = sessionIdOverride ? sessionIdOverride : m_sessionId;
+		header.sequence = m_nextSequence++;
+		if (!m_nextSequence) { m_nextSequence = 1; }
+		return header;
+	}
+
+	void Session::sendHello(std::uint64_t nowMs)
+	{
+		Protocol::Hello hello;
+		hello.nonce = m_localNonce;
+		hello.contentHash = m_config.contentHash;
+		hello.playerName = m_config.playerName;
+		Protocol::Datagram datagram;
+		if (Protocol::encodeHello(makeHeader(Protocol::PacketType::Hello, 0), hello, datagram))
+		{
+			sendDatagram(datagram);
+			m_lastHelloMs = nowMs;
+		}
+	}
+
+	void Session::sendWelcome(const Endpoint& endpoint, std::uint32_t nonce, bool accepted, std::uint16_t reason)
+	{
+		const Endpoint previousPeer = m_peer;
+		m_peer = endpoint;
+		Protocol::Welcome welcome;
+		welcome.nonce = nonce;
+		welcome.playerSlot = 1;
+		welcome.accepted = accepted ? 1 : 0;
+		welcome.reason = reason;
+		Protocol::Datagram datagram;
+		const std::uint32_t responseSession = accepted ? m_sessionId : 0;
+		if (Protocol::encodeWelcome(makeHeader(Protocol::PacketType::Welcome, responseSession), welcome, datagram))
+		{
+			sendDatagram(datagram);
+		}
+		m_peer = previousPeer;
+	}
