+			if (event.flags & ProjectileFlagExplodes) { projectile->flags |= PROJFLAG_EXPLODE; }
+			if (event.flags & ProjectileFlagNoScale) { projectile->flags |= PROJFLAG_DONOT_SCALE; }
+			proj_setTransform(projectile, event.pitch, event.yaw);
+		}
+
+		void applyRemoteUse(const Protocol::UseEvent& event)
+		{
+			if (event.levelHash != s_levelHash || !s_remotePlayer || !validSectorIndex(event.sectorIndex)) { return; }
+			RSector* sector = &s_levelState.sectors[event.sectorIndex];
+			if (s_remotePlayer->sector != sector)
+			{
+				sector_removeObject(s_remotePlayer);
+				sector_addObjectDirect(sector, s_remotePlayer);
+			}
+			s_remotePlayer->posWS = { event.x, event.y, event.z };
+			s_remotePlayer->yaw = static_cast<angle14_16>(event.yaw);
+			fixed16_16 dirX, dirZ;
+			sinCosFixed(event.yaw, &dirX, &dirZ);
+			player_useActionForObject(s_remotePlayer, dirX, dirZ);
+		}
+
+		void logConnectionTransition()
+		{
+			const ConnectionState current = s_session.state();
+			if (current == s_lastConnectionState) { return; }
+			s_lastConnectionState = current;
+			TFE_System::logWrite(current == ConnectionState::Error || current == ConnectionState::Rejected || current == ConnectionState::TimedOut ? LOG_ERROR : LOG_MSG,
+				"Coop", "Connection state: %s%s%s", connectionStateName(current),
+				s_session.error().empty() ? "" : " - ", s_session.error().c_str());
+			if (current != ConnectionState::Connected && s_remotePlayer) { removeRemotePlayer(); }
+		}
+	}
+
+	void configureHost(std::uint16_t port)
+	{
+		s_config.role = Role::Host;
+		s_config.port = port ? port : DefaultPort;
+		s_configured = true;
+	}
