+		if (m_lastPingMs && nowMs - m_lastPingMs < PingIntervalMs) { return; }
+		Protocol::Ping ping;
+		ping.timestampMs = nowMs;
+		Protocol::Datagram datagram;
+		if (Protocol::encodePing(makeHeader(Protocol::PacketType::Ping), Protocol::PacketType::Ping, ping, datagram))
+		{
+			sendDatagram(datagram);
