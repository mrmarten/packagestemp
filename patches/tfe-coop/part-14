+
+using namespace TFE_Coop;
+
+namespace
+{
+	void require(bool condition, const char* message)
+	{
+		if (!condition)
+		{
+			std::cerr << "FAILED: " << message << '\n';
+			std::exit(1);
+		}
+	}
+
+	void pump(Session& host, Session& client, std::uint64_t durationMs)
+	{
+		const std::uint64_t end = monotonicTimeMs() + durationMs;
+		while (monotonicTimeMs() < end)
+		{
+			const std::uint64_t now = monotonicTimeMs();
+			host.update(now);
+			client.update(now);
+			std::this_thread::sleep_for(std::chrono::milliseconds(1));
+		}
+	}
+}
+
+int main()
+{
+	Session host;
+	SessionConfig hostConfig;
+	hostConfig.role = Role::Host;
+	hostConfig.port = 0;
+	hostConfig.playerName = "Host";
+	hostConfig.contentHash = 0x1234abcd;
+	require(host.start(hostConfig), "host starts");
+	require(host.state() == ConnectionState::Listening && host.localPort() != 0, "host listens on an ephemeral port");
+
+	Session client;
+	SessionConfig clientConfig;
+	clientConfig.role = Role::Client;
+	clientConfig.connectHost = "127.0.0.1";
+	clientConfig.port = host.localPort();
+	clientConfig.playerName = "Client One";
+	clientConfig.contentHash = hostConfig.contentHash;
+	require(client.start(clientConfig), "client starts");
+
+	pump(host, client, 300);
+	require(host.connected() && client.connected(), "loopback handshake connects both peers");
+	require(host.sessionId() != 0 && host.sessionId() == client.sessionId(), "session IDs agree");
+	require(host.remotePlayerName() == clientConfig.playerName, "host receives client name");
+
+	Protocol::PlayerState hostState;
+	hostState.simulationTick = 100;
+	hostState.levelHash = 0x5555aaaa;
+	hostState.x = 10;
+	hostState.y = 20;
+	hostState.z = 30;
+	hostState.yaw = 40;
+	hostState.pitch = 50;
+	hostState.sectorIndex = 6;
+	hostState.weapon = 3;
+	hostState.health = 88;
+	hostState.shields = 144;
+	hostState.triggerGoals = 5;
+	hostState.itemGoals = 7;
+	host.submitLocalPlayerState(hostState);
+
+	Protocol::PlayerState clientState = hostState;
+	clientState.simulationTick = 101;
+	clientState.x = -100;
+	clientState.weapon = 5;
+	client.submitLocalPlayerState(clientState);
+	pump(host, client, 120);
+
+	Protocol::PlayerState received;
+	require(client.consumeRemotePlayerState(received), "client receives host state");
+	require(received.x == hostState.x && received.weapon == hostState.weapon && received.triggerGoals == hostState.triggerGoals,
+		"host state values survive network transport");
+	require(host.consumeRemotePlayerState(received), "host receives client state");
+	require(received.x == clientState.x && received.weapon == clientState.weapon, "client state values survive network transport");
+
+	Protocol::ProjectileEvent projectile;
+	projectile.levelHash = hostState.levelHash;
+	projectile.x = 1000;
+	projectile.y = 2000;
+	projectile.z = 3000;
