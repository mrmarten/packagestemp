+		useOut.y == use.y && useOut.z == use.z && useOut.yaw == use.yaw && useOut.pitch == use.pitch &&
+		useOut.sectorIndex == use.sectorIndex, "use round trip");
+
+	Ack ack;
+	ack.acknowledgedType = PacketType::UseEvent;
+	ack.eventId = 0x10203040u;
+	require(encodeAck(header(PacketType::Ack), ack, datagram), "encode ack");
+	Ack ackOut;
+	require(decodeAck(view(datagram), ackOut), "decode ack");
+	require(ackOut.acknowledgedType == ack.acknowledgedType && ackOut.eventId == ack.eventId, "ack round trip");
+
+	Ping ping;
+	ping.timestampMs = 0x0102030405060708ull;
+	require(encodePing(header(PacketType::Ping), PacketType::Ping, ping, datagram), "encode ping");
+	Ping pingOut;
+	require(decodePing(view(datagram), pingOut) && pingOut.timestampMs == ping.timestampMs, "ping round trip");
+
+	require(encodeDisconnect(header(PacketType::Disconnect), 0xbeef, datagram), "encode disconnect");
+	std::uint16_t reason = 0;
+	require(decodeDisconnect(view(datagram), reason) && reason == 0xbeef, "disconnect round trip");
+
+	Datagram corrupt = datagram;
+	corrupt.bytes[0] ^= 0xff;
+	PacketView invalid;
+	require(!decodePacket(corrupt.bytes.data(), corrupt.size, invalid), "bad magic rejected");
+	corrupt = datagram;
+	corrupt.bytes[4] = 0;
+	corrupt.bytes[5] = Version + 1;
+	require(!decodePacket(corrupt.bytes.data(), corrupt.size, invalid), "bad version rejected");
+	require(!decodePacket(datagram.bytes.data(), HeaderSize - 1, invalid), "short header rejected");
+	corrupt = datagram;
+	corrupt.bytes[18] = 0;
+	corrupt.bytes[19] = 1;
+	require(!decodePacket(corrupt.bytes.data(), corrupt.size, invalid), "nonzero reserved header rejected");
+
+	Ack invalidAck;
+	invalidAck.acknowledgedType = PacketType::PlayerState;
+	invalidAck.eventId = 7;
+	require(encodeAck(header(PacketType::Ack), invalidAck, datagram), "encode invalid ack for decoder test");
+	Ack invalidAckOut;
+	require(!decodeAck(view(datagram), invalidAckOut), "ack of unreliable packet rejected");
+
+	std::cout << "coopProtocolTest: PASS\n";
+	return 0;
+}
