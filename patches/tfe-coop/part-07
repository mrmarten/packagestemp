+	bool Session::sendDatagram(const Protocol::Datagram& datagram)
+	{
+		if (!m_peer.valid || !datagram.size) { return false; }
+		if (!m_socket.send(m_peer, datagram.bytes.data(), datagram.size)) { return false; }
+		m_stats.packetsSent++;
+		return true;
+	}
