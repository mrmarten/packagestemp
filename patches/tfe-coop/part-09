+		if (it != m_pendingReliable.end()) { m_pendingReliable.erase(it); }
+		m_stats.pendingReliable = static_cast<std::uint32_t>(m_pendingReliable.size());
+	}
+
+	bool Session::rememberReliable(Protocol::PacketType type, std::uint32_t eventId)
+	{
+		const std::uint64_t key = reliableKey(type, eventId);
+		if (m_recentReliable.find(key) != m_recentReliable.end())
+		{
+			m_stats.duplicateReliableEvents++;
+			return false;
+		}
+		m_recentReliable.insert(key);
+		m_recentReliableOrder.push_back(key);
+		while (m_recentReliableOrder.size() > ReliableHistorySize)
+		{
+			m_recentReliable.erase(m_recentReliableOrder.front());
+			m_recentReliableOrder.pop_front();
+		}
+		return true;
+	}
+
+	void Session::resetPeerState()
+	{
+		m_peer = {};
+		m_remotePlayerName.clear();
+		m_sessionId = 0;
+		m_remoteNonce = 0;
+		m_pendingReliable.clear();
+		m_projectileEvents.clear();
+		m_useEvents.clear();
+		m_recentReliable.clear();
+		m_recentReliableOrder.clear();
+		m_haveRemotePlayerState = false;
+		m_haveRemoteStateSequence = false;
+		m_stats.pendingReliable = 0;
+	}
+
+	void Session::peerTimedOut()
+	{
+		resetPeerState();
+		m_error = "Co-op peer timed out";
+		if (m_config.role == Role::Host)
+		{
+			m_state = ConnectionState::Listening;
+		}
+		else
+		{
+			m_state = ConnectionState::TimedOut;
+			m_socket.close();
+		}
+	}
+
+	void Session::setError(const std::string& error)
+	{
+		m_error = error;
+		m_state = ConnectionState::Error;
+		m_socket.close();
+	}
+}
