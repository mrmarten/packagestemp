+		std::atomic<std::uint32_t> s_idCounter(0x63f14ac5u);
+
+		std::uint32_t generateId()
+		{
+			const std::uint64_t now = monotonicTimeMs();
+			std::uint32_t value = s_idCounter.fetch_add(0x9e3779b9u, std::memory_order_relaxed);
+			value ^= static_cast<std::uint32_t>(now);
+			value ^= static_cast<std::uint32_t>(now >> 32);
+			value ^= value >> 16;
+			value *= 0x7feb352du;
+			value ^= value >> 15;
+			value *= 0x846ca68bu;
+			value ^= value >> 16;
+			return value ? value : 1u;
+		}
