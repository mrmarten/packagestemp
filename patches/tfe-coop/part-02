+			if (!logic) { return; }
+			TFE_DarkForces::ProjectileLogic* projectile = reinterpret_cast<TFE_DarkForces::ProjectileLogic*>(logic);
+			projectile->flags |= PROJFLAG_COOP_REPLICATED;
