+	bool Session::queueProjectileEvent(Protocol::ProjectileEvent event, std::uint32_t* assignedEventId)
+	{
+		if (!connected()) { return false; }
+		if (!event.eventId) { event.eventId = m_nextReliableEventId++; }
+		if (!m_nextReliableEventId) { m_nextReliableEventId = 1; }
+		Protocol::Datagram datagram;
+		if (!Protocol::encodeProjectileEvent(makeHeader(Protocol::PacketType::ProjectileEvent), event, datagram))
+		{
+			return false;
+		}
+		if (assignedEventId) { *assignedEventId = event.eventId; }
+		return queueReliable(Protocol::PacketType::ProjectileEvent, event.eventId, datagram);
+	}
+
