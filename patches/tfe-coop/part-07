+	void Session::update(std::uint64_t nowMs)
+	{
+		if (!nowMs) { nowMs = monotonicTimeMs(); }
+		if (!m_socket.isOpen()) { return; }
+
+		std::uint8_t buffer[Protocol::MaxPacketSize];
+		for (int packetCount = 0; packetCount < 128; packetCount++)
+		{
+			Endpoint endpoint;
+			const int received = m_socket.receive(endpoint, buffer, sizeof(buffer));
+			if (received == 0) { break; }
+			if (received < 0)
+			{
+				setError(m_socket.lastError());
+				return;
+			}
+			m_stats.packetsReceived++;
+			processDatagram(endpoint, buffer, static_cast<std::size_t>(received), nowMs);
+			if (!m_socket.isOpen()) { break; }
+		}
+
+		if (m_state == ConnectionState::Connecting)
+		{
+			if (!m_lastHelloMs || nowMs - m_lastHelloMs >= HelloIntervalMs)
+			{
+				sendHello(nowMs);
+			}
+			if (nowMs - m_startedMs >= HandshakeTimeoutMs)
+			{
+				m_state = ConnectionState::TimedOut;
+				m_error = "Co-op host did not answer within 10 seconds";
+				m_socket.close();
+			}
+			return;
+		}
+
+		if (m_state != ConnectionState::Connected) { return; }
+		if (nowMs - m_lastReceiveMs >= PeerTimeoutMs)
+		{
+			peerTimedOut();
+			return;
+		}
+		sendPlayerState(nowMs);
+		sendPing(nowMs);
+		serviceReliable(nowMs);
+		m_stats.pendingReliable = static_cast<std::uint32_t>(m_pendingReliable.size());
+	}
