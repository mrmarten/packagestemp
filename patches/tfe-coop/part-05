+			out.header.payloadSize != size - HeaderSize) { return false; }
+		out.header.type = static_cast<PacketType>(type);
+		out.payload = data + HeaderSize;
+		out.payloadSize = out.header.payloadSize;
+		return true;
+	}
+
+	bool encodeHello(const Header& header, const Hello& payload, Datagram& out)
+	{
+		return encode(header, [&](Writer& writer) {
+			return writer.u32(payload.nonce) && writer.u32(payload.contentHash) &&
+				writer.string(payload.playerName, MaxPlayerName);
+		}, out);
+	}
+	bool decodeHello(const PacketView& packet, Hello& out)
+	{
+		Reader reader(packet.payload, packet.payloadSize);
+		return packet.header.type == PacketType::Hello && reader.u32(out.nonce) &&
+			reader.u32(out.contentHash) && reader.string(out.playerName, MaxPlayerName) && reader.remaining() == 0;
+	}
+
+	bool encodeWelcome(const Header& header, const Welcome& payload, Datagram& out)
+	{
+		return encode(header, [&](Writer& writer) {
+			return writer.u32(payload.nonce) && writer.u8(payload.playerSlot) &&
+				writer.u8(payload.accepted) && writer.u16(payload.reason);
+		}, out);
+	}
