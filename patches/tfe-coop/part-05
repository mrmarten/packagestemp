+		Reader r(packet.payload, packet.payloadSize);
+		return packet.header.type == PacketType::ProjectileEvent && r.u32(p.eventId) && r.u32(p.levelHash) &&
+			r.i32(p.x) && r.i32(p.y) && r.i32(p.z) && r.i16(p.yaw) && r.i16(p.pitch) &&
+			r.i16(p.sectorIndex) && r.u16(p.projectileType) && r.i16(p.bounceCount) &&
+			r.i32(p.speed) && r.i32(p.damage) && r.i32(p.minDamage) && r.u32(p.remainingTicks) &&
+			r.u8(p.flags) && r.remaining() == 0;
+	}
+
+	bool encodeUseEvent(const Header& header, const UseEvent& p, Datagram& out)
+	{
+		return encode(header, [&](Writer& w) {
+			return w.u32(p.eventId) && w.u32(p.levelHash) && w.i32(p.x) && w.i32(p.y) && w.i32(p.z) &&
+				w.i16(p.yaw) && w.i16(p.pitch) && w.i16(p.sectorIndex);
+		}, out);
+	}
+	bool decodeUseEvent(const PacketView& packet, UseEvent& p)
+	{
+		Reader r(packet.payload, packet.payloadSize);
+		return packet.header.type == PacketType::UseEvent && r.u32(p.eventId) && r.u32(p.levelHash) &&
+			r.i32(p.x) && r.i32(p.y) && r.i32(p.z) && r.i16(p.yaw) && r.i16(p.pitch) &&
+			r.i16(p.sectorIndex) && r.remaining() == 0;
+	}
+
+	bool encodeAck(const Header& header, const Ack& p, Datagram& out)
+	{
+		return encode(header, [&](Writer& w) {
+			return w.u8(static_cast<std::uint8_t>(p.acknowledgedType)) && w.u32(p.eventId);
+		}, out);
+	}
+	bool decodeAck(const PacketView& packet, Ack& p)
+	{
+		Reader r(packet.payload, packet.payloadSize);
+		std::uint8_t type;
+		if (packet.header.type != PacketType::Ack || !r.u8(type) || !r.u32(p.eventId) || r.remaining() != 0) { return false; }
+		p.acknowledgedType = static_cast<PacketType>(type);
+		return p.eventId != 0 && (p.acknowledgedType == PacketType::ProjectileEvent ||
+			p.acknowledgedType == PacketType::UseEvent);
+	}
+
+	bool encodePing(const Header& header, PacketType type, const Ping& p, Datagram& out)
+	{
+		if (type != PacketType::Ping && type != PacketType::Pong) { return false; }
+		Header actual = header;
+		actual.type = type;
+		return encode(actual, [&](Writer& w) { return w.u64(p.timestampMs); }, out);
+	}
+	bool decodePing(const PacketView& packet, Ping& p)
+	{
+		if (packet.header.type != PacketType::Ping && packet.header.type != PacketType::Pong) { return false; }
+		Reader r(packet.payload, packet.payloadSize);
+		return r.u64(p.timestampMs) && r.remaining() == 0;
+	}
+
+	bool encodeDisconnect(const Header& header, std::uint16_t reason, Datagram& out)
+	{
+		return encode(header, [&](Writer& w) { return w.u16(reason); }, out);
+	}
+	bool decodeDisconnect(const PacketView& packet, std::uint16_t& reason)
+	{
+		Reader r(packet.payload, packet.payloadSize);
+		return packet.header.type == PacketType::Disconnect && r.u16(reason) && r.remaining() == 0;
+	}
