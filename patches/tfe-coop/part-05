+			r.i32(p.x) && r.i32(p.y) && r.i32(p.z) && r.i16(p.yaw) && r.i16(p.pitch) && r.i16(p.sectorIndex) &&
+			r.u8(p.weapon) && r.u8(p.flags) && r.i16(p.health) && r.i16(p.shields) &&
+			r.u16(p.triggerGoals) && r.u16(p.itemGoals) && r.remaining() == 0;
+	}
+
+	bool encodeProjectileEvent(const Header& header, const ProjectileEvent& p, Datagram& out)
+	{
+		return encode(header, [&](Writer& w) {
+			return w.u32(p.eventId) && w.u32(p.levelHash) && w.i32(p.x) && w.i32(p.y) && w.i32(p.z) &&
