+bool CruCoopMoverProcess::isInCurrentMap(const Item *item) {
+	// See the comment on the declaration: getMapNum() is meaningless for
+	// usecode-spawned Crusader NPCs. EXT_INCURMAP is the flag CurrentMap
+	// itself maintains for "this item is in the current map's item lists".
+	return item && item->getParent() == 0 &&
+		item->hasExtFlags(Item::EXT_INCURMAP);
+}
