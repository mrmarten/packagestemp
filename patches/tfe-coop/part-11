diff --git a/TheForceEngine/TFE_DarkForces/Coop/coopTransport.h b/TheForceEngine/TFE_DarkForces/Coop/coopTransport.h
new file mode 100644
index 0000000..8483725
--- /dev/null
+++ b/TheForceEngine/TFE_DarkForces/Coop/coopTransport.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+
+namespace TFE_Coop
+{
+	struct Endpoint
+	{
+		std::uint32_t address = 0; // IPv4 address, network byte order.
+		std::uint16_t port = 0;    // Port, network byte order.
+		bool valid = false;
+	};
+
+	bool endpointEquals(const Endpoint& a, const Endpoint& b);
+	std::string endpointToString(const Endpoint& endpoint);
+	bool resolveEndpoint(const char* host, std::uint16_t port, Endpoint& out);
+
+	class UdpSocket
+	{
+	public:
+		UdpSocket() = default;
+		~UdpSocket();
+		UdpSocket(const UdpSocket&) = delete;
+		UdpSocket& operator=(const UdpSocket&) = delete;
+
+		bool open(std::uint16_t bindPort);
+		void close();
+		bool isOpen() const;
+		bool send(const Endpoint& endpoint, const std::uint8_t* data, std::size_t size);
+		int receive(Endpoint& endpoint, std::uint8_t* data, std::size_t capacity);
+		std::uint16_t localPort() const { return m_localPort; }
+		const std::string& lastError() const { return m_lastError; }
+
+	private:
+		std::uintptr_t m_socket = static_cast<std::uintptr_t>(-1);
+		std::uint16_t m_localPort = 0;
+		std::string m_lastError;
+		bool m_platformReady = false;
+	};
+}
