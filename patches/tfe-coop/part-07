+		m_state = ConnectionState::Stopped;
+		m_peer = {};
+		m_sessionId = 0;
+		m_pendingReliable.clear();
+		m_projectileEvents.clear();
+		m_useEvents.clear();
+		m_recentReliable.clear();
+		m_recentReliableOrder.clear();
+		m_haveRemotePlayerState = false;
+		m_haveRemoteStateSequence = false;
+		m_stats.pendingReliable = 0;
+	}
