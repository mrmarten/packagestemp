+			projectile->bounceCnt = event.bounceCount;
+			if (event.speed) { projectile->speed = event.speed; projectile->col_speed = event.speed; }
+			projectile->dmg = event.damage;
+			projectile->minDmg = event.minDamage;
+			projectile->duration = s_curTick + event.remainingTicks;
