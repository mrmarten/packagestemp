+	void Session::sendPlayerState(std::uint64_t nowMs)
+	{
+		if (!m_haveLocalPlayerState || (m_lastStateSendMs && nowMs - m_lastStateSendMs < StateIntervalMs)) { return; }
+		Protocol::Datagram datagram;
+		if (Protocol::encodePlayerState(makeHeader(Protocol::PacketType::PlayerState), m_localPlayerState, datagram))
+		{
+			sendDatagram(datagram);
+			m_lastStateSendMs = nowMs;
+		}
+	}
